prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 61.3.100
Requires: 
Requires.private: libavformat >= 61.7.100, libavcodec >= 61.19.101, libavutil >= 59.39.100
Conflicts:
Libs: "-L${libdir}" -lavdevice
Libs.private: psapi.lib -lole32 -lstrmiids -luuid -loleaut32 -lshlwapi -lgdi32 -lvfw32
Cflags: "-I${includedir}"

